{
  "swagger": "2.0",
  "info": {"title": "Task tracker", "version": "1.0.0"},
  "basePath": "/api",
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "Token": {"type": "apiKey", "in": "header", "name": "Authorization"}
  },
  "security": [{"Token": []}],
  "paths": {
    "/status": {
      "get": {
        "operationId": "getStatus",
        "security": [],
        "responses": {
          "200": {"description": "The service is up.", "schema": {"$ref": "#/definitions/Status"}}
        }
      }
    },
    "/projects": {
      "get": {
        "operationId": "listProjects",
        "parameters": [
          {"name": "page", "in": "query", "type": "integer", "minimum": 1, "description": "Page number."},
          {"name": "limit", "in": "query", "type": "integer", "minimum": 1, "maximum": 50}
        ],
        "responses": {
          "200": {
            "description": "One page of projects.",
            "schema": {"type": "array", "items": {"$ref": "#/definitions/Project"}}
          }
        }
      }
    },
    "/projects/{project}/tasks": {
      "parameters": [{"$ref": "#/parameters/ProjectParam"}],
      "get": {
        "operationId": "listTasks",
        "parameters": [
          {"name": "state", "in": "query", "type": "string", "enum": ["open", "closed"]}
        ],
        "responses": {
          "200": {
            "description": "The project's tasks.",
            "schema": {"type": "array", "items": {"$ref": "#/definitions/Task"}}
          },
          "404": {"$ref": "#/responses/NotFound"}
        }
      },
      "post": {
        "operationId": "createTask",
        "parameters": [
          {"name": "body", "in": "body", "required": true, "schema": {"$ref": "#/definitions/NewTask"}}
        ],
        "responses": {
          "201": {"description": "The new task.", "schema": {"$ref": "#/definitions/Task"}},
          "404": {"$ref": "#/responses/NotFound"},
          "422": {"description": "The task is not valid.", "schema": {"$ref": "#/definitions/ValidationError"}}
        }
      }
    },
    "/projects/{project}/tasks/{task}": {
      "parameters": [
        {"$ref": "#/parameters/ProjectParam"},
        {"name": "task", "in": "path", "required": true, "type": "integer"}
      ],
      "get": {
        "operationId": "getTask",
        "responses": {
          "200": {"description": "The task.", "schema": {"$ref": "#/definitions/Task"}},
          "404": {"$ref": "#/responses/NotFound"}
        }
      },
      "delete": {
        "operationId": "deleteTask",
        "responses": {
          "204": {"description": "Deleted."},
          "404": {"$ref": "#/responses/NotFound"}
        }
      }
    },
    "/projects/{project}/files": {
      "parameters": [{"$ref": "#/parameters/ProjectParam"}],
      "post": {
        "operationId": "uploadFile",
        "consumes": ["multipart/form-data"],
        "parameters": [
          {"name": "upload", "in": "formData", "required": true, "type": "file"}
        ],
        "responses": {
          "201": {"description": "The stored file.", "schema": {"$ref": "#/definitions/Attachment"}}
        }
      }
    },
    "/projects/{project}/files/{file}": {
      "parameters": [
        {"$ref": "#/parameters/ProjectParam"},
        {"name": "file", "in": "path", "required": true, "type": "string"}
      ],
      "get": {
        "operationId": "downloadFile",
        "produces": ["application/octet-stream"],
        "responses": {
          "200": {"description": "The file's bytes.", "schema": {"type": "file"}},
          "404": {"$ref": "#/responses/NotFound"}
        }
      }
    }
  },
  "parameters": {
    "ProjectParam": {"name": "project", "in": "path", "required": true, "type": "string"}
  },
  "responses": {
    "NotFound": {"description": "Not found.", "schema": {"$ref": "#/definitions/Error"}}
  },
  "definitions": {
    "Status": {
      "type": "object",
      "properties": {"ok": {"type": "boolean"}}
    },
    "Project": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "integer", "format": "int64"},
        "name": {"type": "string", "x-go-name": "Name"}
      }
    },
    "Task": {
      "type": "object",
      "required": ["id", "title", "state"],
      "properties": {
        "id": {"type": "integer", "format": "int64"},
        "title": {"type": "string", "example": "Fix login"},
        "state": {"type": "string", "enum": ["open", "closed"]},
        "due_date": {"type": "string", "format": "date-time", "x-nullable": true},
        "priority": {"type": "integer", "minimum": 0, "exclusiveMinimum": true},
        "subtasks": {"type": "array", "items": {"$ref": "#/definitions/Task"}}
      },
      "x-go-package": "tasks/models"
    },
    "NewTask": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "due_date": {"type": "string", "format": "date-time", "x-nullable": true},
        "priority": {"type": "integer", "minimum": 0, "exclusiveMinimum": true}
      }
    },
    "Attachment": {
      "type": "object",
      "properties": {"id": {"type": "integer"}, "name": {"type": "string"}}
    },
    "Error": {
      "type": "object",
      "properties": {"message": {"type": "string"}}
    },
    "ValidationError": {
      "type": "object",
      "properties": {
        "message": {"type": "string"},
        "fields": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
